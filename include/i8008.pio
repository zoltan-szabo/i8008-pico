; Intel 8008 support rig: all PIO programs plus the pin map.
; Assembled to include/i8008.pio.h by pre_build.py (pioasm).

; ---------------------------------------------------------------------------
; Pin map (matches the breadboard wiring of the older hardware/rp2040/8008 rig)
; ---------------------------------------------------------------------------
.define public PIN_STATE_2 2    ; 8008 S2 -- S2 on the LOWEST gpio, so the raw
.define public PIN_STATE_1 3    ; 8008 S1    3-bit state code is bit-reversed
.define public PIN_STATE_0 4    ; 8008 S0    relative to the datasheet S2S1S0
.define public PIN_DATA_0 5     ; 8008 D0
.define public PIN_DATA_1 6
.define public PIN_DATA_2 7
.define public PIN_DATA_3 8
.define public PIN_DATA_4 9
.define public PIN_DATA_5 10
.define public PIN_DATA_6 11
.define public PIN_DATA_7 12    ; 8008 D7
.define public PIN_BUS_WRITE 13 ; debug output: high while the Pico drives D0-D7
.define public PIN_READY 14     ; 8008 READY input
.define public PIN_INT 15       ; 8008 INT input
.define public PIN_CLK1 26      ; 8008 phase 1 clock
.define public PIN_CLK2 27      ; 8008 phase 2 clock
.define public PIN_SYNC 28      ; 8008 SYNC output

.define public CAPTURE_BITS 14  ; gpio 2..15: S2 S1 S0, D0..D7, BUS_WRITE, READY, INT
.define public T3_RAW 4         ; T3 state code as read from the pins (S2 on the lowest gpio)

; ---------------------------------------------------------------------------
; clk: non-overlapping two-phase clock on PIN_CLK1/PIN_CLK2.
; 4 instructions per period; with clkdiv 66 at 125 MHz this is 473 kHz.
; ---------------------------------------------------------------------------
.program clk
.wrap_target
    set pins, 0b00
    set pins, 0b01      ; phase 1 high
    set pins, 0b00
    set pins, 0b10      ; phase 2 high
.wrap

; ---------------------------------------------------------------------------
; capture: one debounced 14-bit snapshot per CLOCK PERIOD (two per T-state),
; taken right after the phi1 rising edge -- T-states begin at phi1 rising,
; so the first snapshot of a state lands within ~200 ns of its onset. That
; early T2 snapshot is what lets the serve reach the bus before T3 begins
; (this 8008 latches read data essentially at T3 onset). The sample is read
; twice, 32 ns apart, until two consecutive reads agree (state lines settle
; slowly through the level shifters). Only changes are pushed; DMA drains
; the RX FIFO into a ring buffer, so no transition is ever lost. The second
; snapshot per state also records mid-state bus changes for the trace.
; x = last pushed sample, stashed in OSR while y/x hold the double-read.
; ---------------------------------------------------------------------------
.program capture
.wrap_target
    wait 1 gpio PIN_CLK1
resample:
    in null, 32
    in pins, CAPTURE_BITS
    in null, (32 - CAPTURE_BITS)     ; right-justify: bits 13..0
    mov y, isr                       ; first read
    in null, 32
    in pins, CAPTURE_BITS
    in null, (32 - CAPTURE_BITS)
    mov x, isr                       ; second read
    jmp x!=y resample                ; not stable yet
    push block                       ; every period is pushed; core1 dedupes
    wait 0 gpio PIN_CLK1
.wrap

; ---------------------------------------------------------------------------
; single_step: pulse READY for one machine cycle, synchronized to SYNC/CLK.
; Any nonzero word in the TX FIFO fires one step.
; ---------------------------------------------------------------------------
.program single_step
    set pins, 0b0        ; power-on: not READY, CPU freezes in WAIT
.wrap_target
main:
    pull block
    mov y, osr
    jmp !y main
    wait 1 gpio PIN_SYNC
    wait 0 gpio PIN_SYNC
    wait 1 gpio PIN_CLK2
    set pins, 0b1        ; READY
    wait 1 gpio PIN_CLK1
    set pins, 0b0        ; not READY
.wrap

; ---------------------------------------------------------------------------
; int_request: pulse INT, raised at CLK1 high, held for N sysclk cycles
; (N = the word pushed into the TX FIFO).
; ---------------------------------------------------------------------------
.program int_request
    set pins, 0b0        ; no INT
.wrap_target
main:
    pull block
    mov y, osr
    jmp !y main
    wait 1 gpio PIN_CLK1
    set pins, 0b1        ; INT
    wait 0 gpio PIN_CLK1
iloop:
    jmp y-- iloop
    set pins, 0b0        ; no INT
.wrap

; ---------------------------------------------------------------------------
; bus_write: serve one byte to the CPU for T3 of a read cycle.
; The 8008 latches read data at the START of T3, so the byte must already be
; stable on the bus when T3 begins. core1 pushes the byte during T2; the SM
; preloads the output latches and takes the bus at the next phi2 FALLING
; edge -- the point where the CPU stops driving its T2 address, 528 ns
; before the phi1 rising edge that starts T3 (our own clock's dead band, so
; no contention). It then holds the bus through any WAIT states (bus floats
; there; single stepping parks between T2 and T3) until the state lines
; show T3, plus 2 us to cover the latch, then releases.
; PIN_BUS_WRITE mirrors the output-enable for scope/trace visibility.
; ---------------------------------------------------------------------------
.program bus_write
.side_set 1 opt
.wrap_target
    pull block side 0
    out pins, 8              ; preload data while pins are still inputs
    mov osr, ~null
    out pindirs, 8 side 1    ; drive immediately: the byte arrives mid-T2
                             ; (settled-sample decode + fast pipeline), the
                             ; CPU has released the bus by then, and the read
                             ; latch closes early in real T3 -- well before
                             ; the VISIBLE state code changes to T3
    set y, T3_RAW
wait_t3:
    mov isr, null
    in pins, 3               ; sample S2 S1 S0
    mov x, isr
    jmp x!=y wait_t3         ; hold through WAIT states until T3 is visible
    set y, 15
hold:
    jmp y-- hold [7]         ; ~1 us past visible T3 onset, then release
    mov osr, null
    out pindirs, 8 side 0    ; release the bus
.wrap
